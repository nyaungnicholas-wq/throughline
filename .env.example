# Throughline environment.
# Local dev needs NOTHING here — it runs on an in-process PGlite database under .data/.
# Set these only when deploying.

# Managed Postgres (Neon/Supabase). When present, the app uses postgres-js instead of PGlite.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Secret for signing/hashing tokens and sessions. REQUIRED in production.
# Generate: openssl rand -base64 32
# APP_SECRET=

# Public base URL, used to build magic-link / invite URLs in emails. REQUIRED in production.
# APP_URL=https://throughline.example.com

# ── AI (optional) ── set ONE; the app auto-detects. Without either it runs deterministic "mock" AI.
# GEMINI_API_KEY=          # Google Gemini (default model gemini-2.5-flash; override with GEMINI_MODEL)
# NVIDIA_API_KEY=          # NVIDIA NIM (default meta/llama-3.3-70b-instruct; override with NVIDIA_MODEL)

# ── Email (optional) ── without RESEND_API_KEY, email is a safe no-op (invites/notifications just don't send).
# RESEND_API_KEY=
# EMAIL_FROM="Throughline <onboarding@resend.dev>"

# ── Scheduled jobs (optional) ── set this, then hit /api/cron/run-due?secret=$CRON_SECRET on a schedule
# (e.g. Vercel Cron) to fire "when overdue" automations. Disabled (403) unless set.
# CRON_SECRET=

# Slack mirroring and outbound webhooks are configured per-workspace in Settings (owner), not via env.
